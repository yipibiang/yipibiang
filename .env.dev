# ============================== 
# 环境变量配置 - 微服务 Monorepo 
# ============================== 
 
# Java / JDK 
JAVA_VERSION=21 
 
# MySQL 
MYSQL_ROOT_PASSWORD=mysql_db_pw
MYSQL_DATABASE=monorepo
MYSQL_PORT=3306 
 
# Redis 
REDIS_PASSWORD=redis_db_pw
REDIS_PORT=6379 
 
# RabbitMQ 
RABBITMQ_DEFAULT_USER=admin 
RABBITMQ_DEFAULT_PASS=admin_mq_pw
RABBITMQ_PORT=5672 
RABBITMQ_MANAGEMENT_PORT=15672 
 
# Jaeger（链路追踪） 
JAEGER_AGENT_HOST=localhost 
JAEGER_AGENT_PORT=6831 
 
# 应用密钥 
JWT_SECRET=your_jwt_secret_here_min_32_chars 
 
# 通用 
TZ=Asia/Shanghai